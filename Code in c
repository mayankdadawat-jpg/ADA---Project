#include <stdio.h>
#include <stdlib.h>

#define MAX_STOCKS 10
#define SCALE 1000   /* 1 unit in DP table = Rs. 1000 */

typedef struct {
    char name[20];
    int price;
    int profit;
    double ratio; /* profit / price */
} Stock;

/* Helper to compare stock ratios for Greedy (Descending) */
int compare(const void *a, const void *b) {
    Stock *s1 = (Stock *)a;
    Stock *s2 = (Stock *)b;
    if (s2->ratio > s1->ratio) return 1;
    if (s2->ratio < s1->ratio) return -1;
    return 0;
}

int max(int a, int b) {
    return (a > b) ? a : b;
}

/* 1. Greedy: Allows Fractional Shares */
void run_greedy(Stock stocks[], int n, int budget) {
    Stock sorted[MAX_STOCKS];
    for (int i = 0; i < n; i++) sorted[i] = stocks[i];
    qsort(sorted, n, sizeof(Stock), compare);

    int remaining = budget;
    double total_profit = 0.0;

    printf("\n--- 1. GREEDY APPROACH (Fractional Shares) ---\n");
    printf("%-16s %-10s %-12s %-10s\n", "Stock", "Allocation", "Spent", "Profit");
    printf("--------------------------------------------------\n");

    for (int i = 0; i < n; i++) {
        if (remaining <= 0) break;

        if (sorted[i].price <= remaining) {
            printf("%-16s 100.0%%     Rs. %-7d  Rs. %-7d\n", 
                   sorted[i].name, sorted[i].price, sorted[i].profit);
            total_profit += sorted[i].profit;
            remaining -= sorted[i].price;
        } else {
            double fraction = (double)remaining / sorted[i].price;
            double frac_profit = sorted[i].profit * fraction;
            printf("%-16s %5.1f%%     Rs. %-7d  Rs. %-7.2f\n", 
                   sorted[i].name, fraction * 100.0, remaining, frac_profit);
            total_profit += frac_profit;
            remaining = 0;
        }
    }

    printf("--------------------------------------------------\n");
    printf("Total Spent : Rs. %d / %d\n", budget - remaining, budget);
    printf("Total Profit: Rs. %.2f\n", total_profit);
}

/* 2. Dynamic Programming: Whole Shares Only (0/1) */
void run_dp(Stock stocks[], int n, int budget) {
    int W = budget / SCALE;
    
    /* Dynamically allocate DP table to support variable budgets */
    int **dp = (int **)malloc((n + 1) * sizeof(int *));
    for (int i = 0; i <= n; i++) {
        dp[i] = (int *)calloc(W + 1, sizeof(int));
    }

    /* Build DP table */
    for (int i = 1; i <= n; i++) {
        int cost = stocks[i - 1].price / SCALE;
        int profit = stocks[i - 1].profit;

        for (int w = 0; w <= W; w++) {
            if (cost <= w) {
                dp[i][w] = max(dp[i - 1][w], dp[i - 1][w - cost] + profit);
            } else {
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

    /* Trace back selected stocks */
    int selected[MAX_STOCKS] = {0};
    int w = W;
    int total_spent = 0;

    for (int i = n; i > 0; i--) {
        if (dp[i][w] != dp[i - 1][w]) {
            selected[i - 1] = 1;
            total_spent += stocks[i - 1].price;
            w -= (stocks[i - 1].price / SCALE);
        }
    }

    printf("\n--- 2. DYNAMIC PROGRAMMING (Whole Shares 0/1) ---\n");
    printf("%-16s %-10s %-12s %-10s\n", "Stock", "Allocation", "Spent", "Profit");
    printf("--------------------------------------------------\n");

    for (int i = 0; i < n; i++) {
        if (selected[i]) {
            printf("%-16s 100.0%%     Rs. %-7d  Rs. %-7d\n", 
                   stocks[i].name, stocks[i].price, stocks[i].profit);
        }
    }

    printf("--------------------------------------------------\n");
    printf("Total Spent : Rs. %d / %d (Idle Cash: Rs. %d)\n", 
           total_spent, budget, budget - total_spent);
    printf("Total Profit: Rs. %d\n\n", dp[n][W]);

    for (int i = 0; i <= n; i++) free(dp[i]);
    free(dp);
}

int main(void) {
    Stock market[MAX_STOCKS] = {
        {"Tata Motors",  8000, 1600, 0.0},
        {"ITC Ltd.",    10000, 1900, 0.0},
        {"Infosys",     14000, 2520, 0.0},
        {"HDFC Bank",   16000, 2880, 0.0},
        {"Reliance",    26000, 4160, 0.0},
        {"TCS",         35000, 4900, 0.0}
    };
    int n = 6;
    int budget = 50000;
    int choice;

    /* Compute initial ratios */
    for (int i = 0; i < n; i++) {
        market[i].ratio = (double)market[i].profit / market[i].price;
    }

    while (1) {
        printf("\n==================================================\n");
        printf("       STOCK PORTFOLIO OPTIMIZER (ADA)            \n");
        printf("==================================================\n");
        printf("Current Budget: Rs. %d\n", budget);
        printf("Available Stocks: %d\n", n);
        printf("--------------------------------------------------\n");
        printf("1. Run Optimization (Greedy vs. 0/1 DP)\n");
        printf("2. Change Investment Budget\n");
        printf("3. Add a Custom Stock\n");
        printf("4. Exit\n");
        printf("--------------------------------------------------\n");
        printf("Enter your choice (1-4): ");
        if (scanf("%d", &choice) != 1) break;

        if (choice == 1) {
            run_greedy(market, n, budget);
            run_dp(market, n, budget);
        } 
        else if (choice == 2) {
            printf("\nEnter new budget in multiples of 1000 (e.g. 40000, 60000, 80000): Rs. ");
            scanf("%d", &budget);
            if (budget < 1000 || budget % SCALE != 0) {
                printf("Note: Rounding down to nearest Rs. 1000 for DP table.\n");
                budget = (budget / SCALE) * SCALE;
            }
            printf("Budget successfully updated to Rs. %d!\n", budget);
        } 
        else if (choice == 3) {
            if (n >= MAX_STOCKS) {
                printf("Stock capacity reached (max %d stocks).\n", MAX_STOCKS);
            } else {
                printf("\nEnter stock name (one word, e.g. Wipro): ");
                scanf("%19s", market[n].name);
                printf("Enter stock price in multiples of 1000 (e.g. 12000): Rs. ");
                scanf("%d", &market[n].price);
                market[n].price = (market[n].price / SCALE) * SCALE;
                printf("Enter expected profit (e.g. 2400): Rs. ");
                scanf("%d", &market[n].profit);
                
                market[n].ratio = (double)market[n].profit / market[n].price;
                n++;
                printf("Stock added successfully!\n");
            }
        } 
        else if (choice == 4) {
            printf("Exiting optimizer.\n");
            break;
        } 
        else {
            printf("Invalid selection, enter a number between 1 and 4.\n");
        }
    }

    return 0;
}
